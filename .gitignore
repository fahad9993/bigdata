_latexmk/
_build/

# ==========================================
# 6. LaTeX Files to KEEP in GitHub
# ==========================================

# Do NOT ignore:
# *.tex           - LaTeX source code
# *.bib           - Bibliography database
# *.sty           - Custom LaTeX style files
# *.cls           - Custom document classes
# *.png / *.jpg   - Figures and screenshots
# *.pdf           - Final compiled assignment report

# =========================================
# Powershell log files
# =========================================

ps_logs/

